From 5e5fccc0fb2db1f0c3af5b4815322b720e34e3ba Mon Sep 17 00:00:00 2001
From: vole-mole <vole-mole@localhost>
Date: Fri, 25 Sep 2026 16:35:33 -0700
Subject: [PATCH 2/2] Add _UTILS_BUILTIN_ for building without OpenSSL

Uses the bundled fips202.c for SHAKE256 and leaves randombytes() to the
application.
---
 src/config.h              | 8 ++++++--
 utils/utils_randombytes.c | 4 ++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/config.h b/src/config.h
index 2a5205c..0dad08d 100644
--- a/src/config.h
+++ b/src/config.h
@@ -47,13 +47,17 @@
 //
 // choose implementations for SHAKE256, AES128CTR, and randombytes() functions
 //
-#if !(defined(_UTILS_OPENSSL_)||defined(_UTILS_SUPERCOP_)||defined(_UTILS_PQM4_)||defined(_UTILS_OQS_))
+// _UTILS_BUILTIN_ uses the bundled utils/fips202.c for SHAKE256 and does not
+// implement randombytes(); it must be provided by the application.
+//
+#if !(defined(_UTILS_OPENSSL_)||defined(_UTILS_SUPERCOP_)||defined(_UTILS_PQM4_)||defined(_UTILS_OQS_)||defined(_UTILS_BUILTIN_))
 // default:
 #define _UTILS_OPENSSL_
 
 //#define _UTILS_SUPERCOP_
 //#define _UTILS_PQM4_
-#endif  // !(defined(_UTILS_OPENSSL_)||defined(_UTILS_SUPERCOP_)||defined(_UTILS_PQM4_))
+//#define _UTILS_BUILTIN_
+#endif  // !(defined(_UTILS_OPENSSL_)||defined(_UTILS_SUPERCOP_)||defined(_UTILS_PQM4_)||defined(_UTILS_OQS_)||defined(_UTILS_BUILTIN_))
 
 //
 // Options for AES128CTR
diff --git a/utils/utils_randombytes.c b/utils/utils_randombytes.c
index d398e43..2c5067f 100644
--- a/utils/utils_randombytes.c
+++ b/utils/utils_randombytes.c
@@ -18,6 +18,10 @@ void randombytes(unsigned char *x, unsigned long long xlen) {
 
 // nothing to do.
 
+#elif defined(_UTILS_BUILTIN_)
+
+// randombytes() is provided by the application.
+
 #elif defined(_NIST_KAT_)
 
 // randombytes() is defined in rng.h/c provided from nist.
-- 
