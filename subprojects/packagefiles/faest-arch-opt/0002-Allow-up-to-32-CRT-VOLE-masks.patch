+// Transpose a (16*N x 32) bit matrix.
+inline void transpose_16Nx32(uint8_t* __restrict__ output, const uint8_t* __restrict__ input,
+                             size_t n_blocks)
+{
+    memset(output, 0x00, 4 * 16 * n_blocks);
+    for (size_t r = 0; r < 16 * n_blocks; ++r)
+    {
+        for (size_t c = 0; c < 32; ++c)
+        {
+            output[2 * n_blocks * c + (r / 8)] |= ((input[4 * r + (c / 8)] >> (c % 8)) & 1)
+                                                  << (r % 8);
+        }
+    }
+}
+
 inline void transpose_16x16N(uint8_t* __restrict__ output, const uint8_t* __restrict__ input,
                              size_t n_blocks)
 {
