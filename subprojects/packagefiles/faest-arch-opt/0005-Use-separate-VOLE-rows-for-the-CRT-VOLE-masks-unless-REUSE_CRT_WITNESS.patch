 template <typename P> constexpr auto PADDED_N_MULT = ((P::CONSTS::CRT_NUM_MULT + 15) / 16) * 16;
 
+// The offset between the two labels of each gate: u on the label rows.
+template <typename P>
+    requires(P::use_crt_vole_masks)
+block_secpar<P::secpar_v> crt_label_offset(const vole_block* __restrict__ u)
+{
+    return block_secpar<P::secpar_v>::load(reinterpret_cast<const uint8_t*>(u) +
+                                           P::CONSTS::CRT_LABEL_ROW_OFFSET / 8);
+}
+
+// The labels G * V or G * Q of the gates, from the label rows of the unlifted VOLE columns.
+template <typename P>
+    requires(P::use_crt_vole_masks)
+void crt_labels(block_secpar<P::secpar_v>* __restrict__ labels,
+                const vole_block* __restrict__ vq_columns)
+{
+    using CP = P::CONSTS;
+    if constexpr (CP::CRT_LABEL_ROW_OFFSET == 0)
+        G_lift_a<P>(labels, vq_columns, CP::VOLE_COL_BLOCKS);
+    else
+    {
+        // Gather the label rows of each column.
+        constexpr size_t STRIDE = (P::secpar_bytes + sizeof(vole_block) - 1) / sizeof(vole_block);
+        std::array<vole_block, P::delta_bits_v * STRIDE> label_columns;
+        for (size_t i = 0; i < P::delta_bits_v; ++i)
+            memcpy(&label_columns[i * STRIDE],
+                   reinterpret_cast<const uint8_t*>(vq_columns + i * CP::VOLE_COL_BLOCKS) +
+                       CP::CRT_LABEL_ROW_OFFSET / 8,
+                   P::secpar_bytes);
+        G_lift_a<P>(labels, label_columns.data(), STRIDE);
+    }
+}
