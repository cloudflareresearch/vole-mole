+++ b/subprojects/packagefiles/xkcp/lib/low/KeccakP-1600-times4/fallback-on2/KeccakP-1600-times4-on2.c
@@ -0,0 +1,34 @@
+/*
+The Keccak-p permutations, designed by Guido Bertoni, Joan Daemen, Michaël Peeters and Gilles Van Assche.
+
+To the extent possible under law, the implementer has waived all copyright
+and related or neighboring rights to the source code in this file.
+http://creativecommons.org/publicdomain/zero/1.0/
+
+---
+
+This file implements Keccak-p[1600]x4 in a PlSnP-compatible way, on top of a Keccak-p[1600]x2
+implementation.
+Please refer to PlSnP-documentation.h for more details.
+
+This implementation comes with KeccakP-1600-times4-SnP.h in the same folder.
+*/
+
+#include "KeccakP-1600-times2-SnP.h"
+#include "KeccakP-1600-times4-SnP.h"
+
+#define prefix                          KeccakP1600times4
+#define PlSnP_baseParallelism           2
+#define PlSnP_targetParallelism         4
+#define SnP_laneLengthInBytes           8
+#define SnP                             KeccakP1600times2
+#define SnP_PermuteAll                  KeccakP1600times2_PermuteAll_24rounds
+#define SnP_PermuteAll_12rounds         KeccakP1600times2_PermuteAll_12rounds
+#define SnP_PermuteAll_6rounds          KeccakP1600times2_PermuteAll_6rounds
+#define SnP_PermuteAll_4rounds          KeccakP1600times2_PermuteAll_4rounds
+#define PlSnP_PermuteAll                KeccakP1600times4_PermuteAll_24rounds
+#define PlSnP_PermuteAll_12rounds       KeccakP1600times4_PermuteAll_12rounds
+#define PlSnP_PermuteAll_6rounds        KeccakP1600times4_PermuteAll_6rounds
+#define PlSnP_PermuteAll_4rounds        KeccakP1600times4_PermuteAll_4rounds
+
+#include "PlSnP-Fallback.inc"
diff --git a/subprojects/packagefiles/xkcp/meson.build b/subprojects/packagefiles/xkcp/meson.build
index 0477dc3..7045b31 100644
--- a/subprojects/packagefiles/xkcp/meson.build
+++ b/subprojects/packagefiles/xkcp/meson.build
@@ -22,6 +22,7 @@ keccak_generic_sources = [
   'lib/low/KeccakP-1600/plain-64bits/KeccakP-1600-opt64.c',
   'lib/low/KeccakP-1600-times4/fallback-on1/KeccakP-1600-times4-on1.c',
 ]
+keccak_asm_sources = []
 keccak_avx2_include_dirs = [
   'lib/low/KeccakP-1600/AVX2/',
   'lib/low/KeccakP-1600/AVX2/SnP/',
@@ -39,13 +40,48 @@ if host_machine.cpu_family() == 'x86_64'
   add_project_arguments('-march=native', '-mtune=native', language : 'c')
   keccak_include_dirs += keccak_avx2_include_dirs
   keccak_sources += keccak_avx2_sources
+elif host_machine.cpu_family() == 'aarch64'
+  # Keccak-p[1600]: plain 64-bit C. Keccak-p[1600]x4: with the ARMv8.4-A SHA3 instructions, two
+  # NEON+SHA3 x2 permutations; without them, the scalar+NEON hybrid x4 core (which is faster than
+  # pure-NEON x2). Both are faster than four serial permutations (fallback-on1).
+  keccak_include_dirs += [
+    'lib/low/KeccakP-1600/plain-64bits/',
+    'lib/low/KeccakP-1600/plain-64bits/SnP/',
+  ]
+  keccak_sources += 'lib/low/KeccakP-1600/plain-64bits/KeccakP-1600-opt64.c'
+  if meson.get_compiler('c').get_define('__ARM_FEATURE_SHA3') != ''
+    keccak_include_dirs += [
+      'lib/low/KeccakP-1600-times2/ARMv8A/',
+      'lib/low/KeccakP-1600-times4/fallback-on2/',
+    ]
+    keccak_sources += [
+      'lib/low/KeccakP-1600-times2/ARMv8A/KeccakP-1600-times2-armv8a-neon.c',
+      'lib/low/KeccakP-1600-times4/fallback-on2/KeccakP-1600-times4-on2.c',
+    ]
+    keccak_asm_sources += [
+      'lib/low/KeccakP-1600-times2/ARMv8A/KeccakP-1600-inplace-pl2-armv8a-neon.s',
+      'lib/low/KeccakP-1600-times2/ARMv8A/KeccakP-1600-times2-x2-v84a-asm.s',
+    ]
+  else
+    keccak_include_dirs += 'lib/low/KeccakP-1600-times4/ARMv8A/'
+    keccak_sources += 'lib/low/KeccakP-1600-times4/ARMv8A/KeccakP-1600-times4-armv8a.c'
+    keccak_asm_sources += 'lib/low/KeccakP-1600-times4/ARMv8A/KeccakP-1600-times4-x4-v8a-asm.s'
+  endif
 else
   keccak_include_dirs += keccak_generic_include_dirs
   keccak_sources += keccak_generic_sources
 endif
 
+# Assembly that needs the C preprocessor. Clang preprocesses .s files anyway, but GCC doesn't.
+keccak_asm_libs = []
+if keccak_asm_sources.length() > 0
+  keccak_asm_libs += static_library('xkcp-asm', keccak_asm_sources,
+    c_args : ['-x', 'assembler-with-cpp'])
+endif
+
 xkcp_lib = static_library('xkcp', keccak_sources,
-  include_directories : keccak_include_dirs)
+  include_directories : keccak_include_dirs,
+  link_whole : keccak_asm_libs)
 
 xkcp_dep = declare_dependency(
   include_directories : keccak_include_dirs,
