+// Enum of the supported hash functions (XOFs). FAEST uses SHAKE. TurboSHAKE (RFC 9861) is the same
+// sponge with the default domain separation byte 0x1F (matching SHAKE's padding), but with the
+// Keccak-p[1600] permutation reduced from 24 to 12 rounds, so it is not compatible with FAEST.
+//
+// SHAKE128 or TurboSHAKE128 is used for secpar 128, and SHAKE256 or TurboSHAKE256 otherwise. The
+// SHAKE-based PRG and leaf hash (leaf_hash::shake) always use SHAKE.
+enum class xof
+{
+    shake,
+    turboshake,
+};
+
 template <secpar S, std::size_t TAU, std::size_t DELTA_BITS, prg TREE_PRG, leaf_hash LEAF_HASH,
           std::size_t VOLE_WIDTH_SHIFT>
