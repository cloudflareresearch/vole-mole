import VoleMole.Verifier.Kats
import VoleMole.Verifier.CrtGen
import VoleMole.Verifier.CrtSearch

/-!
# `lake exe verifier_vectors`

Checks the executable pieces of the Lean VOLEitH verifier (`VoleMole/Verifier/`) against the files
written by `tests/voleith/dump_verifier_vectors.cpp` (format documented there):

* `verifier_prims.txt`: AES-128 (round keys and ciphertexts), `aes_ctr_prg<s128>` (including
  32-bit lane wrap-around of the counter and tweak), and SHAKE128/256 via `Spec.SHAKE` (inputs
  across rate boundaries, multi-block squeezes, a `hash_state_x4` lane).
* `verifier_bavc.txt`: `BAVC.commit` (whole tree, leaves, commitments, check value) and
  `BAVC.reconstruct` (verifier's leaves and commitments, check value) for a fixed seed and `Δ`,
  plus rejection of mutated openings.
* `verifier_kat.txt`: one KAT proof per relation (Moussaka issuance and redemption, Ratatouille
  issuance and spend, PomFRIT redemption with delayed instance binding and binders): the
  parameters and proof layout, `check_format`, `mu`/`mu₁`, `iv`, the BAVC reconstruction and
  `vole_commit_check`, `chal1` (milestone 2); the ConvertToVOLE key columns (milestone 3); the gate
  hashes, `r̃`, the CRT-lifted rows, `q_mask` and the lifted `Δ` (milestone 4). Mutations: flipping
  a byte of the corrections, `c_mult`, the opening or `iv_pre` changes `chal1` or is rejected;
  setting a grinding bit of `Δ` fails `check_format`.

* The CRT tables: `CrtGen`'s recomputations and identity check, and `F`, `G`, `W_tree`, `W_gate`
  regenerated by `CrtSearch` (the port of `vole_mult_tables.py`) and compared with `CrtData`.

* All KAT proofs (`Verifier/Kats.lean`, milestone 6): every proof in the Moussaka, Ratatouille
  and PomFRIT KAT files is verified in full and must be accepted; mutated proofs and instances
  must be rejected.

The proof layout (`Params.labelRows`) is read off the dump: `correction_rows` is `8 · witness_bytes`
on `main` and `8 · witness_bytes + 128` with dedicated label rows (a `voleith-label-rows` build of the
dumper, with `TESTS_DIR` that branch's `tests/`); all records must agree.

Usage: `lake exe verifier_vectors [VECTOR_DIR [TESTS_DIR [FILTER]]]` (defaults `vectors`,
`../tests`, and the empty filter; with a filter, only the KAT checks whose label starts with it run).
Exits with status 1 on any failure.
-/

namespace VoleMole.Verifier.Vectors

open VoleMole.Verifier

def checkPrims (rs : Array Record) : IO (Bool × Nat) := do
  let mut ok := true
  let mut n := 0
  for r in rs do
    n := n + 1
    match r.group with
    | "aes" =>
      let rk := AES.expandKey (r.bytes "key")
      ok := (← check s!"aes {r.name} rk" (rk == r.bytes "rk")) && ok
      ok := (← check s!"aes {r.name} ct" (AES.encrypt rk (r.bytes "pt") == r.bytes "ct")) && ok
    | "prg" =>
      let out := AES.prg (r.bytes "key") (r.bytes "iv") (r.get "tweak").toNat!.toUInt32
        (r.get "counter").toNat!.toUInt32 4
      ok := (← check s!"prg {r.name}" (out == r.bytes "out")) && ok
    | "shake" =>
      let expected := r.bytes "out"
      let input := r.bytes "input"
      let out := if r.get "secpar" == "128" then Spec.SHAKE.shake128 input expected.size
        else Spec.SHAKE.shake256 input expected.size
      ok := (← check s!"shake {r.name}" (expected.size > 0 && out == expected)) && ok
    | g => ok := (← check s!"unknown record {g} {r.name}" false) && ok
  return (ok, n)

def checkBavc (rs : Array Record) : IO Bool := do
  let some c := rs.find? (·.name == "commit") | check "bavc commit record" false
  let some o := rs.find? (·.name == "open") | check "bavc open record" false
  let iv := c.bytes "iv"
  let (tree, lv) := BAVC.commit (c.bytes "seed") iv
  let mut ok := true
  ok := (← check "bavc commit tree" (tree.foldl (· ++ ·) ByteArray.empty == c.bytes "tree")) && ok
  ok := (← check "bavc commit leaves" (lv.keys == c.bytes "leaves")) && ok
  ok := (← check "bavc commit hashed_leaves" (lv.coms == c.bytes "hashed_leaves")) && ok
  ok := (← check "bavc commit check" (BAVC.check lv.coms == c.bytes "check")) && ok
  let opening := o.bytes "opening"
  let delta := o.bytes "delta"
  match BAVC.reconstruct iv opening delta with
  | none => ok := (← check "bavc open accepted" false) && ok
  | some v =>
    ok := (← check "bavc open leaves" (v.keys == o.bytes "leaves")) && ok
    ok := (← check "bavc open hashed_leaves" (v.coms == o.bytes "hashed_leaves")) && ok
    ok := (← check "bavc open check" (BAVC.check v.coms == o.bytes "check")) && ok
  -- Mutations: a nonzero trailing byte is rejected; a flipped seed byte changes the check value.
  let last := opening.size - 1
  let bad := opening.set! last (opening.get! last ^^^ 1)
  if opening.get! last == 0 then
    ok := (← check "bavc mutated padding rejected" (BAVC.reconstruct iv bad delta).isNone) && ok
  let seedByte := BAVC.tau * BAVC.hashLen
  let bad2 := opening.set! seedByte (opening.get! seedByte ^^^ 1)
  ok := (← check "bavc mutated seed changes check"
    ((BAVC.reconstruct iv bad2 delta).map (BAVC.check ·.coms) != some (o.bytes "check"))) && ok
  return ok

def w128s (b : ByteArray) (stride : Nat) : Array W128 :=
  (Array.range (b.size / stride)).map fun i => W128.ofBytes b (stride * i)

def parseTables (r : Record) : CrtTables :=
  let g := r.bytes "g"
  { mI := wordsOf (r.bytes "m_i")
    wCrt := w128s (r.bytes "w_crt") 16
    wTree := w128s (r.bytes "w_tree") 16
    wGate := w128s (r.bytes "w_gate") 16
    g := (Array.range (g.size / 40)).map fun i => wordsOf (g.extract (40 * i) (40 * i + 40)) }

def w128Bytes (a : Array W128) : ByteArray := a.foldl (fun acc w => acc ++ w.toBytes) ByteArray.empty

def u32Bytes (a : Array UInt32) : ByteArray := a.foldl AES.pushLE32 ByteArray.empty

/-- Whether a KAT record has the dedicated-label-row layout. -/
def labelRowsOf (r : Record) : Bool :=
  (r.get "correction_rows").toNat! != 8 * (r.get "witness_bytes").toNat!

/-- Milestones 2-5 on one KAT record; returns success. -/
def checkKatRecord (T : CrtTables) (r : Record) : IO Bool := do
  let label := r.name
  let p : Params := { witnessBytes := (r.get "witness_bytes").toNat!,
                      qsDegree := (r.get "qs_degree").toNat!, labelRows := labelRowsOf r }
  let pf : Proof := { params := p, bytes := r.bytes "proof" }
  let mut ok := true
  ok := (← check s!"{label} params" (p.nMask == (r.get "n_mask").toNat! &&
    p.voleColBlocks == (r.get "vole_col_blocks").toNat! &&
    p.voleRows == (r.get "vole_rows").toNat! &&
    p.correctionRows == (r.get "correction_rows").toNat! &&
    pf.bytes.size == p.proofBytes)) && ok
  ok := (← check s!"{label} check_format" pf.checkFormat) && ok
  -- Milestone 2: mu, iv, BAVC, chal1.
  let inst := r.bytes "inst_enc"
  let dst := r.bytes "dst"
  let delayed := r.get "delayed" == "1"
  let mu := Verifier.mu (some inst) dst
  let mu1 := if delayed then Verifier.mu none dst else mu
  ok := (← check s!"{label} mu" (mu == r.bytes "mu" && mu1 == r.bytes "mu1")) && ok
  let iv := ivOf pf mu1
  ok := (← check s!"{label} iv" (iv == r.bytes "iv")) && ok
  let t0 ← IO.monoMsNow
  let some leaves := BAVC.reconstruct iv pf.opening pf.delta
    | check s!"{label} bavc accepted" false
  let check1 := BAVC.check leaves.coms
  ok := (← check s!"{label} leaves" (leaves.keys == r.bytes "leaves" &&
    leaves.coms == r.bytes "hashed_leaves")) && ok
  ok := (← check s!"{label} vole_commit_check" (check1 == r.bytes "vole_commit_check")) && ok
  let c1 := chal1 pf mu1 check1 (r.bytes "binder1")
  ok := (← check s!"{label} chal1" (c1 == r.bytes "chal1")) && ok
  let t1 ← IO.monoMsNow
  -- Milestone 3: ConvertToVOLE.
  let cols := convertToVole pf iv leaves
  ok := (← check s!"{label} q_columns" (columnsBytes cols == r.bytes "q_columns")) && ok
  let t2 ← IO.monoMsNow
  -- Milestone 4: CRT.
  let crt := crtReconstruct pf T iv cols
  ok := (← check s!"{label} gate_hashes" (u32Bytes crt.hashes == r.bytes "gate_hashes")) && ok
  ok := (← check s!"{label} r_tilde" (w128Bytes crt.rTilde == r.bytes "r_tilde")) && ok
  ok := (← check s!"{label} q_rows" (w128Bytes crt.rows == r.bytes "q_rows")) && ok
  ok := (← check s!"{label} q_mask" (w128Bytes crt.qMask == r.bytes "q_mask")) && ok
  ok := (← check s!"{label} delta_lifted" (crt.deltaLifted.toBytes == r.bytes "delta_lifted")) && ok
  let t3 ← IO.monoMsNow
  -- Milestone 5: VOLE check and chal2.
  let hV := voleHashReceiver p c1 crt.rows crt.qMask crt.deltaLifted.toGF pf.voleCheck
  let c2 := chal2 pf c1 hV (if delayed then mu else ByteArray.empty) (r.bytes "binder2")
  ok := (← check s!"{label} chal2" (c2 == r.bytes "chal2")) && ok
  let t4 ← IO.monoMsNow
  -- Mutations: each changes chal1 (or is rejected).
  let flip (off : Nat) : Proof := { pf with bytes := pf.bytes.set! off (pf.bytes.get! off ^^^ 1) }
  let chal1Of (q : Proof) : Option ByteArray := do
    if !q.checkFormat then none
    let l ← BAVC.reconstruct (ivOf q mu1) q.opening q.delta
    some (chal1 q mu1 (BAVC.check l.coms) (r.bytes "binder1"))
  for (k, _) in p.fieldSizes do
    if k == "corrections" || k == "cmult" || k == "open" || k == "iv_pre" then
      let some (off, n) := p.field? k | pure ()
      for o in [off, off + n / 2, off + n - 1] do
        ok := (← check s!"{label} mutated {k}@{o}" (chal1Of (flip o) != some c1)) && ok
  ok := (← check s!"{label} mutated grinding bits rejected" !(flip (pf.params.proofBytes - 21)).checkFormat) && ok
  IO.println s!"  {label}: bavc+chal1 {t1 - t0} ms, ConvertToVOLE {t2 - t1} ms, CRT {t3 - t2} ms, KOS {t4 - t3} ms"
  return ok

def checkKat (rs : Array Record) : IO Bool := do
  let some tr := rs.find? (·.group == "crt") | check "crt tables record" false
  let T := parseTables tr
  let mut ok := true
  ok := (← check "crt tables shape" (T.mI.size == 17 && T.wCrt.size == 120 && T.wTree.size == 120 &&
    T.wGate.size == 312 && T.g.size == 120)) && ok
  let mut n := 0
  for r in rs do
    if r.group == "kat" then
      n := n + 1
      ok := (← checkKatRecord T r) && ok
  ok := (← check "kat records" (n == 5)) && ok
  let lr := (rs.filter (·.group == "kat")).map labelRowsOf
  ok := (← check "kat records: one layout" (lr.all (· == lr[0]!))) && ok
  return ok

def main (args : List String) : IO UInt32 := do
  let dir := args.headD "vectors"
  let prims := parse (← IO.FS.readFile s!"{dir}/verifier_prims.txt")
  let (ok1, n) ← checkPrims prims
  IO.println s!"verifier_prims: {n} records, {if ok1 then "ok" else "FAILED"}"
  let ok2 ← checkBavc (parse (← IO.FS.readFile s!"{dir}/verifier_bavc.txt"))
  IO.println s!"verifier_bavc: {if ok2 then "ok" else "FAILED"}"
  let katRecs := parse (← IO.FS.readFile s!"{dir}/verifier_kat.txt")
  let ok3 ← checkKat katRecs
  IO.println s!"verifier_kat: {if ok3 then "ok" else "FAILED"}"
  let some tr := katRecs.find? (·.group == "crt") | return 1
  -- The CRT tables from `CrtData`: recomputed parts, the defining identity, and agreement with the
  -- C++ row tables. The KAT run below uses them, not the dumped ones.
  let D := parseTables tr
  let G := CrtGen.tables
  let t0 ← IO.monoMsNow
  let okT := (← check "CRT: M_tree = prod M_i" CrtGen.mTreeOk) &&
    (← check "CRT: W_crt = CRT basis of the moduli" CrtGen.wCrtOk) &&
    (← check "CRT: bilinear identity of F, G, W_tree, W_gate" CrtGen.identityOk) &&
    (← check "CRT: row tables = C++ tables" (G.mI == D.mI && G.wCrt == D.wCrt &&
      G.wTree == D.wTree && G.wGate == D.wGate && G.g == D.g))
  let t1 ← IO.monoMsNow
  IO.println s!"CRT tables: {if okT then "ok" else "FAILED"} ({t1 - t0} ms)"
  -- F, G, W_tree, W_gate regenerated by the port of `vole_mult_tables.py`.
  let R ← IO.lazyPure fun _ => CrtSearch.generate
  let okR ← check "CRT: regenerated F, G, W_tree, W_gate = CrtData" (CrtSearch.regenOk R)
  IO.println s!"CRT tables regenerated: {R.picks.length} places, {R.F.size} gates, \
    {if okR then "equal to CrtData" else "DIFFERENT"}"
  let labelRows := (katRecs.find? (·.group == "kat")).any labelRowsOf
  IO.println s!"Proof layout: {if labelRows then "dedicated label rows" else "main"}"
  let ok4 ← Kats.main G katRecs dir (args.getD 1 "../tests") (args.getD 2 "") labelRows
  return if ok1 && ok2 && ok3 && okT && okR && ok4 then 0 else 1

end VoleMole.Verifier.Vectors

def main (args : List String) : IO UInt32 := VoleMole.Verifier.Vectors.main args
