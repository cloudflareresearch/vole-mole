import Mathlib

/-!
# Fibres of group homomorphisms (sketch §4, L1 and L2)

`ImU φ U` is the subgroup `Im_U = Σ_{e ∈ U} φ_e(V) ≤ T`. L1 bounds the fibres of a homomorphism of
finite abelian groups, and L2 is the resulting bound on the probability that a uniformly random
assignment of label values hits a fixed check target.

L4 (`Product.lean`) uses `card_fiber_mul_card_le_of_le_range` directly, applied to a homomorphism on
all of `Ω = L → V` rather than on `V^U`; `uniform_hit_le` is the literal statement of L2.
-/

open Finset

set_option linter.unusedSectionVars false

namespace VoleMole.Extraction

section L1

variable {A B : Type*} [AddCommGroup A] [Fintype A] [AddCommGroup B] [DecidableEq B]

lemma card_ker_mul_card_range (f : A →+ B) :
    Nat.card f.ker * Nat.card f.range = Fintype.card A := by
  rw [← AddSubgroup.index_ker, AddSubgroup.card_mul_index, Nat.card_eq_fintype_card]

lemma card_fiber_zero (f : A →+ B) : #{a | f a = 0} = Nat.card f.ker := by
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  simp [AddMonoidHom.mem_ker]

/-- **L1**, nonempty fibres: a fibre over a point of the image has exactly `|A| / |f(A)|`
elements. -/
theorem card_fiber_mul_card_range (f : A →+ B) {t : B} (ht : t ∈ f.range) :
    #{a | f a = t} * Nat.card f.range = Fintype.card A := by
  obtain ⟨a, rfl⟩ := ht
  rw [AddMonoidHom.card_fiber_eq_of_mem_range f ⟨a, rfl⟩ ⟨0, map_zero f⟩, card_fiber_zero,
    card_ker_mul_card_range]

/-- **L1**: every fibre has at most `|A| / |f(A)|` elements. -/
theorem card_fiber_mul_card_range_le (f : A →+ B) (t : B) :
    #{a | f a = t} * Nat.card f.range ≤ Fintype.card A := by
  by_cases ht : t ∈ f.range
  · exact (card_fiber_mul_card_range f ht).le
  · have : #{a | f a = t} = 0 := by
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      exact fun a _ h => ht ⟨a, h⟩
    simp [this]

/-- L1 with the image replaced by any subgroup `I` of it. -/
theorem card_fiber_mul_card_le_of_le_range (f : A →+ B) {I : AddSubgroup B} (hI : I ≤ f.range)
    (t : B) : #{a | f a = t} * Nat.card I ≤ Fintype.card A :=
  (Nat.mul_le_mul_left _ (AddSubgroup.card_le_of_le hI)).trans (card_fiber_mul_card_range_le f t)

/-- The probability form of L1: `|A|⁻¹ · #{a | f a = t} ≤ |I|⁻¹`. -/
theorem fiber_prob_le_of_le_range (f : A →+ B) {I : AddSubgroup B} [Finite I] (hI : I ≤ f.range)
    (t : B) : (Fintype.card A : ℝ)⁻¹ * #{a | f a = t} ≤ (Nat.card I : ℝ)⁻¹ := by
  have hA : (0 : ℝ) < Fintype.card A := by exact_mod_cast Fintype.card_pos
  have hI0 : (0 : ℝ) < Nat.card I := by exact_mod_cast Nat.card_pos
  rw [inv_mul_le_iff₀ hA, ← div_eq_mul_inv, le_div_iff₀ hI0]
  exact_mod_cast card_fiber_mul_card_le_of_le_range f hI t

end L1

section L2

variable {𝔼 V T : Type*} [DecidableEq 𝔼] [AddCommGroup V] [Fintype V] [AddCommGroup T]
  [DecidableEq T]

/-- `Im_U := Σ_{e ∈ U} φ_e(V)`, the subgroup of `T` generated by the images of the gates in `U`. -/
def ImU (φ : 𝔼 → V →+ T) (U : Finset 𝔼) : AddSubgroup T :=
  ⨆ e ∈ U, (φ e).range

/-- `(v_e)_{e ∈ U} ↦ Σ_{e ∈ U} φ_e(v_e)`. -/
def sumHom (φ : 𝔼 → V →+ T) (U : Finset 𝔼) : (U → V) →+ T :=
  ∑ e : U, (φ e).comp (Pi.evalAddMonoidHom (fun _ => V) e)

lemma sumHom_apply (φ : 𝔼 → V →+ T) (U : Finset 𝔼) (v : U → V) :
    sumHom φ U v = ∑ e : U, φ e (v e) := by
  simp [sumHom]

lemma ImU_le_range_sumHom (φ : 𝔼 → V →+ T) (U : Finset 𝔼) : ImU φ U ≤ (sumHom φ U).range := by
  refine iSup₂_le fun e he => ?_
  rintro _ ⟨v, rfl⟩
  refine ⟨Pi.single ⟨e, he⟩ v, ?_⟩
  rw [sumHom_apply, Finset.sum_eq_single ⟨e, he⟩]
  · simp
  · intro e' _ hne
    simp [hne]
  · simp

/-- **L2** (uniform hit probability):
`|V|^{-|U|} · #{(v_e) ∈ V^U | Σ_{e ∈ U} φ_e(v_e) = t} ≤ |Im_U|⁻¹`. -/
theorem uniform_hit_le [Finite T] (φ : 𝔼 → V →+ T) (U : Finset 𝔼) (t : T) :
    ((Fintype.card V : ℝ) ^ U.card)⁻¹ * #{v : U → V | ∑ e : U, φ e (v e) = t}
      ≤ (Nat.card (ImU φ U) : ℝ)⁻¹ := by
  have h := fiber_prob_le_of_le_range (sumHom φ U) (ImU_le_range_sumHom φ U) t
  convert h using 3
  · simp
  · simp only [sumHom_apply]

end L2

end VoleMole.Extraction
